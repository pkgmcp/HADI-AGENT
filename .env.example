APP_NAME=HADI-Agent
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# MCP Default Provider
MCP_DEFAULT_PROVIDER=openai
MCP_TOKEN_TRACKING=true
MCP_COMPRESSION_ENABLED=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234

# Agent Configuration
PLANNER_PROVIDER=openai
CODER_PROVIDER=anthropic
REVIEWER_PROVIDER=openai
DEBUGGER_PROVIDER=anthropic

# AI Routing
AI_ROUTING_STRATEGY=latency
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=ollama
AI_RATE_LIMIT_ENABLED=true
AI_CACHE_ENABLED=true
AI_BUDGET_LIMIT=100.00
