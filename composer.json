{
    "name": "hadi/hadi-agent",
    "description": "Hadi Agent Laravel package",
    "type": "library",
    "license": "MIT",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "authors": [
        {
            "name": "pkgmcp",
            "email": "pkgmcp@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hadi\\HadiAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hadi\\HadiAgent\\Support\\HadiServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^1.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}